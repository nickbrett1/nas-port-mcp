# Environment variables for nas-port-mcp (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

MCP_PORT=3001
# Bind address for mcpo. Default 0.0.0.0 so the tailnet MagicDNS hostname
# (nas.tail*.ts.net:3001) is reachable from clients like Open WebUI.
# For strict tailnet-only exposure, set MCP_HOST=<your tailnet IP>.
#MCP_HOST=0.0.0.0
